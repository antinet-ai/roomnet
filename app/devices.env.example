# Copy to site/devices.env (gitignored) and fill in. Never commit the filled copy.
# Camera: make a camera account in the Mercusys app under
# Device Settings > Advanced Settings > Camera Account.
CAMERA_HOST=192.168.1.20
CAMERA_USER=
CAMERA_PASSWORD=
# Plug: the TP-Link account the Tapo app uses; the plug checks it locally.
PLUG_HOST=192.168.1.21
# Hub and bulb: give each device a fixed address in the router (a DHCP
# reservation), or a new device can take its address. The agent checks
# the model at each address and says when a different device answers.
HUB_HOST=192.168.1.22
BULB_HOST=192.168.1.23
# The hub's sensors, by the names they have in the Tapo app.
DOOR_SENSOR=
MOTION_SENSOR=
CLIMATE_SENSOR=
TAPO_USERNAME=
TAPO_PASSWORD=
